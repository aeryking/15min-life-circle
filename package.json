{
  "name": "life-circle-checkup",
  "version": "1.0.0",
  "description": "基于百度地图开放能力的「15 分钟生活圈」智能体检与规划助手",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.js",
    "serve": "npm run build && npm start",
    "test": "node --test tests/*.test.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "record": "node scripts/record.js",
    "validate": "node scripts/validate.js"
  },
  "dependencies": {
    "d3-contour": "^4.0.2",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "echarts": "^5.5.1",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "html2canvas-pro": "^2.4.5",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "prettier": "^3.4.2",
    "vite": "^6.0.7",
    "vue": "^3.5.13"
  }
}
