# ============================================================
#  15 分钟生活圈体检助手 · 环境变量
#  复制本文件为 .env 后按需填写；.env 已被 .gitignore 忽略，切勿提交真实密钥
#  不填写任何 AK 也能运行：服务自动进入「离线回放模式」，使用 data/replay 中录制的真实数据
# ============================================================

# —— 百度地图开放平台 AK（https://lbsyun.baidu.com → 控制台 → 应用管理）
# 服务端 AK：应用类型选「服务端」，需开通 地点检索 / 地理编码 / 逆地理编码 / 批量算路 / 路线规划 / 坐标转换
BAIDU_SERVER_AK=
# 浏览器端 AK：应用类型选「浏览器端」，开通 JavaScript API，Referer 白名单填部署域名（本地可填 localhost*）
# 未配置时前端自动使用开源底图（Leaflet + 高德瓦片）
BAIDU_BROWSER_AK=

# —— 数据模式：auto（有服务端 AK 用 live，否则 replay）| live | replay
DATA_MODE=auto

# —— 服务
PORT=8787
HOST=0.0.0.0

# —— 百度 API 调用策略（个人认证开发者建议 QPS ≤ 10）
BAIDU_QPS=8
BAIDU_CONCURRENCY=6
BAIDU_TIMEOUT_MS=8000
BAIDU_MAX_RETRIES=3
BAIDU_MATRIX_MAX_ELEMENTS=50

# —— 可选：OpenStreetMap 补充数据源
OSM_ENABLED=true
OSM_TIMEOUT_MS=8000

# —— 可选：大模型（兼容 OpenAI Chat Completions 协议，如 通义千问 / DeepSeek / 文心 / Kimi）
# LLM_BASE_URL 填厂商文档中的 Base URL（与 OpenAI SDK 的 base_url 相同），程序会自动拼接 /chat/completions
# 例（DeepSeek）：LLM_BASE_URL=https://api.deepseek.com  LLM_MODEL=deepseek-flash
# 例（通义千问）：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 可选：附加到请求体的厂商参数（JSON）。DeepSeek 未配置时默认 {"thinking":{"type":"disabled"}}（关闭思考模式，回答更快）
LLM_EXTRA_BODY=
# 可选：是否支持对话框的「深度思考」开关（请求体 thinking 字段）。auto：按地址识别 DeepSeek；true / false 手动指定
LLM_THINKING=auto

# —— 可选：故障注入（演示容错降级），也可在界面「技术指标」页实时开关
CHAOS_ENABLED=false
CHAOS_FAILURE_RATE=0.2
CHAOS_QPS_LIMIT_RATE=0.1
